{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../build-windows",
      "cacheVariables": {
        "DHEWM3LIBS": "${sourceDir}/../.deps/dhewm3-libs/x86_64-w64-mingw32"
      }
    },
    {
      "name": "linux-x86_64",
      "displayName": "Linux – x86_64 (64-bit Intel/AMD)",
      "description": "Standard x86_64 Linux build. Default for most desktop and server Linux hosts.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux – arm64 / aarch64",
      "description": "64-bit ARM Linux build (Raspberry Pi 4/5, Ampere, AWS Graviton, etc.).",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux – Release (portable binary, $ORIGIN RPATH)",
      "description": "Optimised release build with RPATH set to $ORIGIN/libs/ so dependencies can be bundled next to the binary for portable distribution.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "binaryDir": "${sourceDir}/../build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LINUX_RELEASE_BINS": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS – Apple Silicon (arm64)",
      "description": "Primary target: arm64, macOS 11.0+. Default for M-series Macs.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "macos-intel",
      "displayName": "macOS – Intel (x86_64)",
      "description": "Secondary target: x86_64, macOS 10.15+. Default for Intel Macs.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS – Universal Binary (release only)",
      "description": "Universal arm64+x86_64, macOS 11.0+, reproducible build. For distributable releases only.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "binaryDir": "${sourceDir}/../build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "REPRODUCIBLE_BUILD": "ON"
      }
    },
    {
      "name": "web-wasm",
      "displayName": "Web – optimised WebAssembly via Emscripten",
      "description": "Emscripten port with WebGL2/GLES3 compat layer (renderer/qgl_gles.h + tr_gles.cpp). Requires emsdk activated (EMSDK env var). HARDLINK_GAME=ON (no dlopen on web), base game only, ImGui/tools/dedicated off. Rendering not yet visually correct; see docs/WEB.md.",
      "binaryDir": "${sourceDir}/../build-web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HARDLINK_GAME": "ON",
        "BASE": "ON",
        "D3XP": "OFF",
        "CORE": "ON",
        "DEDICATED": "OFF",
        "IMGUI": "OFF",
        "SDL2": "ON",
        "WEB_SIMD": "ON"
      }
    },
    {
      "name": "web-wasm-debug",
      "inherits": "web-wasm",
      "displayName": "Web – WebAssembly with debug information",
      "binaryDir": "${sourceDir}/../build-web-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "RelWithDebInfo" },
    {
      "name": "linux-x86_64",
      "displayName": "Build – Linux x86_64",
      "configurePreset": "linux-x86_64"
    },
    {
      "name": "linux-arm64",
      "displayName": "Build – Linux arm64",
      "configurePreset": "linux-arm64"
    },
    {
      "name": "linux-release",
      "displayName": "Build – Linux Release (portable)",
      "configurePreset": "linux-release"
    },
    {
      "name": "macos-arm64",
      "displayName": "Build – macOS Apple Silicon",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-intel",
      "displayName": "Build – macOS Intel",
      "configurePreset": "macos-intel"
    },
    {
      "name": "macos-universal",
      "displayName": "Build – macOS Universal (release only)",
      "configurePreset": "macos-universal"
    },
    {
      "name": "web-wasm",
      "displayName": "Build – Web WebAssembly via Emscripten (GLES compat)",
      "configurePreset": "web-wasm"
    },
    {
      "name": "web-wasm-debug",
      "configurePreset": "web-wasm-debug"
    }
  ]
}
